# Copy to .env and fill in. The real .env is git-ignored. Every line is optional; the value
# shown is the default. App mode (`vault run --app`) ignores the five path and reader settings.

# The vault folder the app reads and writes. The default is the synthetic vault used for
# development and tests; the installed app takes the real Family Vault folder from its own
# config file, never from this repository.
VAULT_ROOT=./var/synthetic-vault
# SQLite database file (relative paths resolve against the checkout).
VAULT_DB=./var/vault.db
# Household roster file: the people and the names documents may carry.
VAULT_HOUSEHOLD=./var/household.json
# Folder for the application log.
VAULT_LOG_DIR=./var/logs
# How pages are read: mac (Apple Vision), stand-in (synthetic truth) or recorded (saved output).
VAULT_READER=mac
# Folder of recorded reads, used when VAULT_READER is recorded. Empty by default.
VAULT_RECORDINGS=
# Where the local Ollama listens; only localhost, 127.0.0.1 and ::1 are accepted.
OLLAMA_URL=http://127.0.0.1:11434
# The model that reads the page image and fills the fields.
VAULT_VISION_MODEL=qwen3-vl:4b
# The text-only model used when the vision model is unavailable.
VAULT_FALLBACK_MODEL=qwen3:4b
# Address the web app listens on; anything but this Mac needs VAULT_READER=stand-in.
VAULT_HOST=127.0.0.1
# Port the web app listens on.
VAULT_PORT=8710

# Gemini API key, used only for the opt-in model comparison on synthetic documents (free tier:
# https://aistudio.google.com/apikey). Empty by default, and the app never needs it.
GEMINI_API_KEY=
